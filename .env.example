# Copy to .env and edit. Never commit .env.  Values shown are the defaults.

# --- LLM -------------------------------------------------------------------
LLM_PROVIDER=ollama            # ollama | huggingface | openai | extractive (no generation)
LLM_MODEL=phi3:mini            # Ollama model tag (Phi-3 Mini is TEXT-ONLY)
OLLAMA_URL=http://localhost:11434
HF_MODEL=microsoft/Phi-3-mini-4k-instruct
OPENAI_API_KEY=                # only for LLM_PROVIDER=openai / VISION_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
# set LLM_MODEL=gpt-4o-mini when LLM_PROVIDER=openai

# --- Vision (needed for charts/diagrams/photos) -------------------------------
VISION_PROVIDER=auto           # auto (=same model if openai, else off) | none | ollama | openai
VISION_MODEL=llava:7b          # e.g. llava:7b, llama3.2-vision, minicpm-v, gpt-4o-mini
CAPTION_IMAGES_AT_INGEST=false # true = caption every extracted image once at upload (slow, better recall)

# --- Embeddings / retrieval ---------------------------------------------------
EMBEDDING_BACKEND=sentence-transformers   # sentence-transformers | hashing (tests only)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER=lexical               # none | lexical | cross-encoder
TOP_K=6
MIN_VECTOR_SIMILARITY=0.50     # below this AND low keyword overlap => "not enough information". Calibrate!
MIN_LEXICAL_OVERLAP=0.34

# --- Generation limits (Phi-3-mini-4k has a 4096-token window) -----------------
NUM_CTX=4096
MAX_CONTEXT_CHARS=7000
MAX_NEW_TOKENS=600
TEMPERATURE=0.1

# --- Extraction ---------------------------------------------------------------
OCR_ENABLED=true
OCR_LANG=eng
TESSERACT_CMD=                 # Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TABLE_BACKEND=auto             # auto | pymupdf | pdfplumber
RENDER_PAGES=true

# --- Safety limits --------------------------------------------------------------
MAX_FILE_MB=50
MAX_PDF_PAGES=300
DATA_DIR=./data
LOG_LEVEL=INFO
